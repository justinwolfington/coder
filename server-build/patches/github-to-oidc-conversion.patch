diff --git a/buildinfo/buildinfo_externalurl_test.go b/buildinfo/buildinfo_externalurl_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e455de068f990da78af2f94923f235ce94145be9
--- /dev/null
+++ b/buildinfo/buildinfo_externalurl_test.go
@@ -0,0 +1,45 @@
+package buildinfo //nolint:testpackage // Tests the unexported source URL selection helper.
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestExternalURLFor(t *testing.T) {
+	t.Parallel()
+
+	const upstreamRepository = "https://github.com/coder/coder"
+	const revision = "81add7e766144e50b4e4499b81582f997cc6a26c"
+	const mirrorCommitURL = "https://github.com/abridgeai/coder-upstream/commit/81add7e766144e50b4e4499b81582f997cc6a26c"
+
+	tests := []struct {
+		name     string
+		override string
+		revision string
+		want     string
+	}{
+		{
+			name:     "Override",
+			override: mirrorCommitURL,
+			revision: revision,
+			want:     mirrorCommitURL,
+		},
+		{
+			name: "NoRevision",
+			want: upstreamRepository,
+		},
+		{
+			name:     "UpstreamRevision",
+			revision: revision,
+			want:     upstreamRepository + "/commit/" + revision,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			require.Equal(t, test.want, externalURLFor(test.override, test.revision))
+		})
+	}
+}
