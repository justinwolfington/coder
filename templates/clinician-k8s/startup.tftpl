#!/bin/bash
set -euo pipefail

# Set up user environment
# Seed .bashrc only on a fresh home volume. The home directory is a persistent
# PVC and this script re-runs on every restart, so an unconditional copy would
# clobber the user's edits (and any dotfiles-managed .bashrc) each boot.
export USER_HOME="/home/vscode"
if [ ! -f "$USER_HOME/.bashrc" ]; then
  sudo cp /root/.bashrc "$USER_HOME/.bashrc"
  sudo chown vscode:vscode "$USER_HOME/.bashrc"
fi

# Install code-server if not present
export CODE_SERVER_DIR="/tmp/code-server"
if [ ! -f "$CODE_SERVER_DIR/bin/code-server" ]; then
  mkdir -p "$CODE_SERVER_DIR"
  curl -fsSL https://code-server.dev/install.sh | sh -s -- --method=standalone --prefix="$CODE_SERVER_DIR"
fi

# Install VS Code extensions
$CODE_SERVER_DIR/bin/code-server --install-extension ms-python.python
$CODE_SERVER_DIR/bin/code-server --install-extension ms-toolsai.jupyter

# Start code-server
$CODE_SERVER_DIR/bin/code-server --auth none --port 13337 >/tmp/code-server.log 2>&1 &
