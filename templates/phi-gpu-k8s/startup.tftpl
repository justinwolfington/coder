#!/bin/bash
set -euo pipefail

# PHI-compliant workspace initialization
echo "Initializing PHI-compliant workspace..."
export PHI_WORKSPACE=true
export PHI_COMPLIANCE_MODE=enabled
export LANGSMITH_API_KEY=coder

# Register Git LFS filters in the workspace user's Git config.
git lfs install

# Start code-server with pre-installed extensions
# Use writable directories in /tmp since the filesystem is read-only
# With egress locked down, code server will not support installing new extensions
mkdir -p /tmp/code-server-data/User
if [ ! -f /tmp/code-server-data/User/settings.json ]; then
  cat > /tmp/code-server-data/User/settings.json <<'EOF'
{
  "workbench.colorTheme": "Dark Modern"
}
EOF
fi

code-server \
  --auth none \
  --port 13337 \
  --user-data-dir /tmp/code-server-data \
  --config /tmp/code-server-config/config.yaml \
  --extensions-dir /opt/code-server-extensions \
  >/tmp/code-server.log 2>&1 &

echo "PHI workspace ready!"
