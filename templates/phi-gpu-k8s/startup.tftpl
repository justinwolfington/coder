#!/bin/bash
set -e

# If a repo is requested, ensure GitHub auth is present; fail fast with guidance
if [ "${should_clone}" = "true" ] && [ -z "$${GITHUB_TOKEN}" ]; then
  echo "GitHub authentication is required to clone ${repo_url} but was not found."
  echo "Please authenticate with GitHub in Coder (Account → External Authentication), then retry."
  exit 1
fi

# PHI Workspace Initialization
echo "Initializing PHI-compliant workspace..."

# Install and start code-server
export CODE_SERVER_DIR="/tmp/code-server"

if [ ! -f "$CODE_SERVER_DIR/bin/code-server" ]; then
  mkdir -p "$CODE_SERVER_DIR"
  curl -fsSL https://code-server.dev/install.sh | sh -s -- --method=standalone --prefix="$CODE_SERVER_DIR" || exit 1
fi

# Install VS Code extensions for PHI development
$CODE_SERVER_DIR/bin/code-server --install-extension ms-python.python
$CODE_SERVER_DIR/bin/code-server --install-extension ms-toolsai.jupyter
$CODE_SERVER_DIR/bin/code-server --install-extension ms-vscode.vscode-typescript-next

# PHI-specific environment setup
echo "Setting up PHI compliance environment..."
export PHI_WORKSPACE=true
export PHI_COMPLIANCE_MODE=enabled

$CODE_SERVER_DIR/bin/code-server --auth none --port 13337 >/tmp/code-server.log 2>&1 &

echo "PHI workspace ready!"
