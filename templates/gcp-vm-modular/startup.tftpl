#!/bin/bash
set -euo pipefail

echo "Initializing environment for ${username}..."

# Update system packages (skip NVIDIA drivers to avoid version conflicts)
export DEBIAN_FRONTEND=noninteractive
apt-mark hold 'nvidia-*' 'libnvidia-*' 'fabricmanager-*' 2>/dev/null || true

apt-get update -y
apt-get install -y curl wget git vim htop unzip jq sudo build-essential

apt-mark unhold 'nvidia-*' 'libnvidia-*' 'fabricmanager-*' 2>/dev/null || true

# Create user with sudo access
if ! id "${username}" &>/dev/null; then
    useradd -m -s /bin/bash "${username}"
    echo "${username} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${username}
    chmod 0440 /etc/sudoers.d/${username}
    usermod -aG sudo "${username}"
fi

chown -R "${username}:${username}" "/home/${username}"

# Install Docker
if ! command -v docker &>/dev/null; then
    curl -fsSL https://get.docker.com | sh
    systemctl enable --now docker
    usermod -aG docker "${username}"
fi

# Mount local SSDs if available (for H100 instances)
if [[ "${gpu_type}" == "nvidia-h100-80gb" ]]; then
    echo "Setting up local NVMe storage..."
    mkdir -p /mnt/nvme
    for device in /dev/nvme*n1; do
        if [[ -e "$device" ]]; then
            mount_point="/mnt/nvme/$(basename "$device")"
            mkdir -p "$mount_point"
            mkfs.ext4 -F "$device" 2>/dev/null || true
            mount "$device" "$mount_point" 2>/dev/null || true
            chown -R "${username}:${username}" "$mount_point"
        fi
    done
    echo "Local NVMe storage ready"
fi

# Configure git defaults
su - "${username}" -c "
    git config --global init.defaultBranch main
    git config --global user.name '${username}'
    git config --global user.email '${useremail}'
"

# Install Claude Code CLI (continue if it fails)
echo "Installing Claude Code CLI..."
su - "${username}" -c "
    curl -fsSL https://claude.ai/install.sh | bash || echo 'Claude Code installation failed, continuing...'
" || true

# Set up environment variables for the coder agent
echo "export HOME=/home/${username}" >> /etc/environment
echo "export USER=${username}" >> /etc/environment

echo "Workspace setup complete for ${username}: Machine: ${gpu_type} | Image: ${dl_image}"
